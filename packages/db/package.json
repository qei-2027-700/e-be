{
  "name": "@e-be/db",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs",
      "require": "./dist/schema.js"
    },
    "./plans": {
      "types": "./dist/plans.d.ts",
      "import": "./dist/plans.mjs",
      "require": "./dist/plans.js"
    },
    "./event-transitions": {
      "types": "./dist/event-transitions.d.ts",
      "import": "./dist/event-transitions.mjs",
      "require": "./dist/event-transitions.js"
    },
    "./notification-types": {
      "types": "./dist/notification-types.d.ts",
      "import": "./dist/notification-types.mjs",
      "require": "./dist/notification-types.js"
    },
    "./station-lines": {
      "types": "./dist/station-lines.d.ts",
      "import": "./dist/station-lines.mjs",
      "require": "./dist/station-lines.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts src/plans.ts src/event-transitions.ts src/notification-types.ts src/station-lines.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/schema.ts src/plans.ts src/event-transitions.ts src/notification-types.ts src/station-lines.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.2"
  }
}
